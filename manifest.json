{
  "manifest_version": 3,
  "name": "Solicitud Ambulatorio",
  "version": "1.1",
  "description": "Automatización de login y gestión de órdenes para Micam.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://micamsalud.com.ar/*",
    "*://*.micamsalud.com.ar/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ]
}